{
  "name": "@praeko/sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "Cliente JS do serviço Praeko (API REST com chave). Sem dependências; funciona em Node, Workers e navegador (o envio de arquivo do disco fica em @praeko/sdk/node).",
  "license": "MIT",
  "keywords": [
    "praeko",
    "api",
    "sdk",
    "social-media",
    "youtube",
    "instagram",
    "tiktok",
    "scheduler"
  ],
  "homepage": "https://praeko.app/docs",
  "bugs": {
    "url": "https://praeko.app/docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Praeko/praeko-js.git",
    "directory": "packages/sdk"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./contract-docs": {
      "types": "./dist/contract-docs.d.ts",
      "default": "./dist/contract-docs.js"
    },
    "./contract-docs.en": {
      "types": "./dist/contract-docs.en.d.ts",
      "default": "./dist/contract-docs.en.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/build-sdk.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
