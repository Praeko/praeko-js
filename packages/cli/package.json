{
  "name": "@praeko/cli",
  "version": "0.4.0",
  "type": "module",
  "description": "Praeko CLI: publishes and schedules short videos on YouTube, Instagram and TikTok, and talks to the Praeko service API (praeko.app).",
  "license": "MIT",
  "keywords": [
    "praeko",
    "cli",
    "social-media",
    "youtube",
    "instagram",
    "tiktok",
    "scheduler"
  ],
  "homepage": "https://praeko.app/docs",
  "bugs": {
    "url": "https://praeko.app/docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Praeko/praeko-js.git",
    "directory": "packages/cli"
  },
  "bin": {
    "praeko": "dist/praeko.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-cli.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@praeko/core": "*",
    "@praeko/sdk": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
