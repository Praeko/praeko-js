{
  "name": "@praeko/studio-kit",
  "version": "0.2.3",
  "type": "module",
  "description": "Praeko Studio scene parts (panel, box, line, bubble, code, window, phone, frame) and the declarative episode that reads the compiled episode.yaml. A library for projects created with `praeko studio init`.",
  "license": "MIT",
  "keywords": [
    "praeko",
    "video",
    "shorts",
    "remotion",
    "captions",
    "kit"
  ],
  "homepage": "https://praeko.app/docs",
  "bugs": {
    "url": "https://praeko.app/docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Praeko/praeko-js.git",
    "directory": "studio/packages/kit"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../../scripts/build-studio.mjs kit",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@praeko/studio-core": "^0.2.0",
    "react": "^19.0.0",
    "remotion": "^4.0.539"
  },
  "devDependencies": {
    "@praeko/studio-core": "*",
    "@types/react": "19.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "engines": {
    "node": ">=22"
  }
}
