{
  "name": "@praeko/studio",
  "version": "0.2.4",
  "type": "module",
  "description": "Praeko Studio: short (9:16) and long (16:9) videos from a script, for you to run with your own coding agent (Claude Code, Codex, Gemini CLI, Cursor, opencode). Voice, word-by-word captions, scenes, cover, texts and publishing through Praeko.",
  "license": "MIT",
  "keywords": [
    "praeko",
    "video",
    "shorts",
    "remotion",
    "captions",
    "studio",
    "cli",
    "agent",
    "shorts"
  ],
  "homepage": "https://praeko.app/docs",
  "bugs": {
    "url": "https://praeko.app/docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Praeko/praeko-js.git",
    "directory": "studio/packages/cli"
  },
  "bin": {
    "praeko-studio": "dist/praeko-studio.mjs"
  },
  "files": [
    "dist",
    "templates",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../../scripts/build-studio.mjs cli",
    "prepack": "npm run build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.75.0"
  },
  "devDependencies": {
    "@praeko/studio-hyperframes": "*",
    "@praeko/studio-publish": "*",
    "@praeko/studio-review": "*",
    "@praeko/studio-voice": "*",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
