{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"], "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true, "esModuleInterop": true, "types": ["node"],
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "noImplicitOverride": true, "noUncheckedIndexedAccess": false
  },
  "include": ["src", "test"]
}
