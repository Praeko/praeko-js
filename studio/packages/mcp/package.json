{
  "name": "@praeko/studio-mcp",
  "version": "0.1.1",
  "type": "module",
  "description": "Local MCP server for Praeko Studio: lets an agent without a terminal (Claude Desktop and others) write the brief and script, compile, make the draft voice, render, cover and package a video, and upload it to the Praeko media library. Stdio only; it never publishes and never shows a key.",
  "license": "MIT",
  "keywords": [
    "praeko",
    "studio",
    "mcp",
    "model-context-protocol",
    "video",
    "shorts",
    "agent"
  ],
  "homepage": "https://praeko.app/docs",
  "bugs": {
    "url": "https://praeko.app/docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Praeko/praeko-js.git",
    "directory": "studio/packages/mcp"
  },
  "bin": {
    "praeko-studio-mcp": "dist/praeko-studio-mcp.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../../scripts/build-studio.mjs mcp",
    "prepack": "npm run build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@praeko/studio": "^0.2.1",
    "zod": "4.6.7",
    "@elevenlabs/elevenlabs-js": "^2.75.0"
  },
  "devDependencies": {
    "yaml": "^2.9.1",
    "@praeko/sdk": "*",
    "@praeko/studio-voice": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
