{
  "name": "praeko-js",
  "version": "0.0.0",
  "private": true,
  "description": "Código-cliente do Praeko: @praeko/sdk e @praeko/cli (o servidor é fechado).",
  "license": "MIT",
  "type": "module",
  "homepage": "https://praeko.app/docs",
  "bugs": {
    "url": "https://praeko.app/docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Praeko/praeko-js.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run build:sdk && node --test packages/*/test/*.test.mjs",
    "typecheck": "npm run typecheck -w packages/sdk -w packages/core -w packages/cli",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "release:check": "node scripts/release-check.mjs",
    "prepare": "npm run build:sdk"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
